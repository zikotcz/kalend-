rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Stejné e-maily jako ADMIN_EMAILS v docs/firebase-config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['honzik.kozak.hkk@gmail.com'];
    }
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{uid} {
      // Uživatel vidí jen svůj záznam, správce všechny.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      // Uživatel si může vytvořit jen vlastní záznam, a to pouze ve stavu "pending".
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      // Měnit stav (schválit / zamítnout) smí jen správce.
      allow update, delete: if isAdmin();
    }

    // Sdílený kalendář – vidí a zapisují jen schválení uživatelé (a správce).
    // Každý smí upravit/smazat své události, správce všechny.
    match /events/{eventId} {
      function validEvent() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$');
      }
      allow read: if isAdmin() || isApproved();
      allow create: if (isAdmin() || isApproved()) && validEvent()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid))
        && validEvent()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid);
    }
  }
}
